    "explanation": "Sitemap 是指引谷歌蜘蛛批量抓取您全站链接的“导航地图”。没有自动更新的 Sitemap 会使您的新网页收录周期从几小时延长至数周甚至数月，导致推广更新非常被动。"
  },
  {
    "id": 9,
    "title": "9. 对方的案例网站，其 CSS 和 JS 等静态样式资源文件是否进行了现代的 Brotli 级或 Gzip 压缩传输？",
    "options": [
      {
        "text": "未经过任何合并和压缩，加载时需要发起几十个大容量明文 JS/CSS 链接请求",
        "score": 10
      },
      {
        "text": "代码高度合并精简，服务器端启用了 Brotli / Gzip 高压缩传输，传输体积大减",
        "score": 0
      }
    ],
    "explanation": "没有经过压缩的静态文件会导致浏览器渲染阻塞（Render-Blocking），耗尽用户的手机网络带宽。高压缩比的静态资源传输是确保网站能够首屏秒开的技术基石之一。"
  },
  {
    "id": 10,
    "title": "10. 建站交付时，对方是否能为您免费在后台配置安装谷歌官方 GA4 数据统计代码以及 Search Console 站长平台？",
    "options": [
      {
        "text": "不包，或者需要额外加收高额的分析代码埋点费用，只给裸站",
        "score": 15
      },
      {
        "text": "免费包办 GA4 和 GSC 的配置绑定，并针对最核心的询盘表单提交配置了转化追踪",
        "score": 0
      }
    ],
    "explanation": "GA4 和 Search Console 是您了解客户来源、哪些词带来了曝光以及询盘漏斗情况的核心统计工具。如果交付时不进行表单埋点绑定，您在后续投放谷歌广告或做 SEO 时就等于闭眼摸索，根本无法掌握成效。"
  }
];
  const seoSecondaryQuestions: QuizQuestion[] = [
  {
    "id": 11,
    "title": "11. 网站在进行多语言翻译时，是使用机器生硬翻译，还是采用针对海外当地语法习惯的人工精修？",
    "options": [
      {
        "text": "纯机翻，后台安装个实时翻译插件直接出结果，读起来极其拗口别扭",
        "score": 15
      },
      {
        "text": "人工精校，由懂行人员针对海外本土用语习惯、行业专业术语进行重构润色",
        "score": 0
      }
    ],
    "explanation": "谷歌官方曾明确指出，虽然不排斥 AI 和机器翻译，但“机器生硬翻译且未加人工润色、存在大量阅读硬伤的垃圾内容”会被谷歌 Helpful Content 算法识别并重罚，更会打击真实买家的询盘意愿。"
  },
  {
    "id": 12,
    "title": "12. 对方提供的网站后台系统，是否能够自由地将多媒体图片、文件接入 CDN（内容分发网络）进行加速传输？",
    "options": [
      {
        "text": "不支持，必须保存在本服务器上，无法对接像 Cloudflare 这样的加速服务",
        "score": 10
      },
      {
        "text": "支持，全站图片、字体等静态资源支持轻松接入全球 CDN 缓存加速",
        "score": 0
      }
    ],
    "explanation": "出海推广针对的是全球不同国家的用户。不支持 CDN 加速意味着远在美国或欧洲的买家需要直接拉取您国内或某个单点服务器的大图，极易因为跨国路由延迟导致网站打不开。"
  },
  {
    "id": 13,
    "title": "13. 网站是否做好了 Canonical（权威链接）标签的声明输出？",
    "options": [
      {
        "text": "没有 Canonical 标签声明，同个页面可能因为参数不同产生多个 URL 指向",
        "score": 10
      },
      {
        "text": "有，每个页面都会自动在头文件中声明唯一的 Canonical 权威原链接",
        "score": 0
      }
    ],
    "explanation": "Canonical 标签是告诉谷歌“如果这个页面由于参数有多个 URL 副本，请统一只将这一个主 URL 进行排名”的指令。缺少此声明会导致谷歌判断您网站有大量重复页面，严重稀释网站权重。"
  },
  {
    "id": 14,
    "title": "14. 网站的产品列表分类，是否支持按“分类标签 + 关联属性”进行利于 SEO 结构树的多重筛选？",
    "options": [
      {
        "text": "不支持，或者只能进行简单的大类查看，不能组合参数筛选过滤",
        "score": 10
      },
      {
        "text": "支持，可以根据产品属性（如尺寸、材质、用途）进行利于蜘蛛追踪的面包屑筛选",
        "score": 0
      }
    ],
    "explanation": "高级的分类多重筛选可以帮蜘蛛顺着属性路由爬取到更底层的细分页面。扁平化且支持条件归类的产品树结构是目前谷歌大中型营销站提高海量长尾词排名的核心利器。"
  },
  {
    "id": 15,
    "title": "15. 对方交付的网站，是否在前端代码的 `<html>` 标签上正确声明了该页面对应的语种（如 lang='en'）？",
    "options": [
      {
        "text": "未声明，或者所有翻译站点上的 html lang 统一都是默认的 zh-CN",
        "score": 10
      },
      {
        "text": "正确声明，英文站显示 lang='en'，西班牙语站显示 lang='es'，根据语种动态变动",
        "score": 0
      }
    ],
    "explanation": "页面的 HTML lang 属性是浏览器和搜索引擎在底层判定网页语种的第一关。如果英文站的 html 声明写着中文，谷歌可能会在搜索中向英语地区用户降低展示推荐频次，极大折损曝光。"
  }
];

  const coreQuestions = activeTab === "vendor" ? vendorQuestions : seoQuestions;
  const secondaryQuestions = activeTab === "vendor" ? vendorSecondaryQuestions : seoSecondaryQuestions;
  
  const allQuestions = [...coreQuestions, ...secondaryQuestions];

  // Load Math challenge for exposure
  const initMathChallenge = () => {
    const n1 = Math.floor(Math.random() * 9) + 1;
    const n2 = Math.floor(Math.random() * 9) + 1;
    setMathChallenge({ n1, n2, ans: n1 + n2 });
    setExpMathAns("");
  };

  useEffect(() => {
    initMathChallenge();
  }, []);

  const handleStart = () => {
    setCurrentStep(1);
    setSelectedOptions({});
    setShowChoicePanel(false);
  };

  const handleSelectOption = (question: QuizQuestion, score: number, text: string) => {
    setSelectedOptions(prev => ({ ...prev, [question.id]: { score, text } }));
  };

  const handleNext = () => {
    const totalCoreCount = coreQuestions.length;

    if (currentStep < totalCoreCount) {
      setCurrentStep(currentStep + 1);
    } else if (currentStep === totalCoreCount) {
      // Step 10 finished, show choice panel
      setShowChoicePanel(true);
    } else if (currentStep >= totalCoreCount + 1 && currentStep < allQuestions.length) {
      setCurrentStep(currentStep + 1);
    } else {
      // Final step finished
      setCurrentStep(999);
    }
  };

  const handlePrev = () => {
    if (currentStep > 1) {
      setCurrentStep(currentStep - 1);
    } else {
      setCurrentStep(0);
    }
  };

  const handleStopQuiz = () => {
    setCurrentStep(999);
  };

  const handleProceedToResultsDirectly = () => {
    setShowChoicePanel(false);
    setCurrentStep(999);
  };

  const handleStartSecondaryQuiz = () => {
    setShowChoicePanel(false);
    setCurrentStep(coreQuestions.length + 1);
  };

  const handleReset = () => {
    setCurrentStep(0);
    setSelectedOptions({});
    setShowChoicePanel(false);
  };

  // Score Calculations
  const answersList = Object.entries(selectedOptions);
  const totalScore = answersList.reduce((acc, [_, val]) => acc + val.score, 0);

  const getSafetyLevel = (score: number) => {
    if (score >= 71) {
      return {
        level: "高风险 - 重度雷区",
        color: "#ef4444",
        summary: "极度危险！该建站服务商极有可能是流水线式的模板推销公司。对方的条款中存在极强的用户锁定陷阱（不给源码且强收昂贵年费），或者在 SEO 排名、价格构成上存在严重浮夸虚假包装。强烈建议您立刻暂停合作，或者添加微信：maogeotop 获取猫哥团队的二次免费人工诊断，避免建站烂尾造成惨重损失！"
      };
    }
    if (score >= 31) {
      return {
        level: "中风险 - 警惕级别",
        color: "#f59e0b",
        summary: "请小心！该建站商存在明显的套路销售行为，或在关键的网站所有权（如服务器强绑定）、代码加载性能保障上拒绝做出承诺。建议必须向对方施加压力，要求将“PageSpeed Speed Index 手机端测分不低于 80 分”、“免费移交完整源码与数据库包”这两条强制性写入合同的最终验收红线！"
      };
    }
    return {
      level: "低风险 - 靠谱级别",
      color: "#10b981",
      summary: "恭喜！您选择或接触的建站服务商在关键的商务所有权、SEO 代码规范、以及交付透明度上得分非常安全。没有发现明显的忽悠套路，技术思路也很靠谱，建议继续推进，细节做好合同留底即可！"
    };
  };

  const safetyInfo = getSafetyLevel(totalScore);

  const handleExposureSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (parseInt(expMathAns) !== mathChallenge.ans) {
      setExposureNotice({ type: "error", msg: "❌ 算术验证码计算错误，请重新输入！" });
      initMathChallenge();
      return;
    }
    setExposureNotice({
      type: "success",
      msg: `✓ 曝光提交成功！已成功登记针对公司「${expCompany}」的曝光信息。后续猫哥团队会主动联系您邮箱进行维权！`
    });
    setExpCompany("");
    setExpPlatform("");
    setExpEmail("");
    setExpExperience("");
    initMathChallenge();
  };

  const handleCopyWechat = () => {
    const wechat = "maogeotop";
    navigator.clipboard.writeText(wechat).then(() => {
      alert("微信号 maogeotop 已成功复制到剪贴板，请打开微信添加好友咨询。");
    }).catch(() => {
      alert("复制失败，请手动添加微信客服：maogeotop");
    });
  };

  // Static sidebar content
  const hotPosts: PostItem[] = [
    { title: "外贸建站合同里的三大夺命陷阱", slug: "contract-traps", views: 2420 },
    { title: "如何让谷歌 AI 优先收录并检索你的网页", slug: "google-ai-indexing", views: 1890 },
    { title: "为什么大公司做的网站往往又慢又贵", slug: "large-company-speed", views: 1650 },
    { title: "WordPress 主题模板修改网站常见硬伤", slug: "wp-theme-flaws", views: 1420 },
    { title: "2026 年最新谷歌 SEO 16 大站内标签优化指南", slug: "seo-tags-guide", views: 1250 }
  ];

  return (
    <main className="mg-audit-wrapper" >
      <div className="mg-audit-container">
        
        {/* 1. Breadcrumbs Header */}
        <header className="mg-audit-header-card">
          <div className="mg-audit-breadcrumbs">
            <Link href="/">首页</Link> &gt; <span>自测避坑与曝光维权</span>
          </div>
          <h1 className="mg-audit-main-title">外贸独立站避雷自测与曝光维权中心</h1>
          <p className="mg-audit-sub-desc">
            多维度在线诊断建站合作硬伤与谷歌技术 SEO 雷点，汇总被投诉低质公司，协助外贸卖家发起法律合规维权。
          </p>
        </header>

        

        {/* 3. Middle Flow */}
        <main className="mg-audit-main-flow">
          
          <nav className="mg-quiz-switcher-bar">
            <button 
              className={`mg-switcher-btn ${activeTab === "vendor" ? "active" : ""}`}
              onClick={() => { setActiveTab("vendor"); handleReset(); }}
            >
              🏡 建站服务商防坑自测
            </button>
            <button 
              className={`mg-switcher-btn ${activeTab === "seo" ? "active" : ""}`}
              onClick={() => { setActiveTab("seo"); handleReset(); }}
            >
              🚀 GEO/SEO 优化技术自测
            </button>
            <button 
              className={`mg-switcher-btn ${activeTab === "exposure" ? "active" : ""}`}
              onClick={() => { setActiveTab("exposure"); }}
            >
              ⚖️ 曝光违权低质商户
            </button>
          </nav>

          <div className="mg-audit-quiz-card">
            
            {activeTab !== "exposure" && currentStep === 0 && (
              <div className="mg-panel-state mg-state-welcome active">
                <span className="mg-welcome-icon">{activeTab === "vendor" ? "🛡️" : "🚀"}</span>
                <h2>{activeTab === "vendor" ? "建站服务商靠谱自测" : "GEO/SEO 优化技术自测"}</h2>
                <p>
                  {activeTab === "vendor" 
                    ? "本自测主要部分由 10 道核心提问组成，回答完成后可提交查看当前评估结果，也可选择继续深度测试。" 
                    : "本技术级别自测能客观评分您的网页代码对于搜索引擎和 AI 大模型的友好度，防范低技术水准交付。"}
                </p>
                <button className="mg-welcome-btn" onClick={handleStart}>开始诊断测试 →</button>
              </div>
            )}

            {activeTab !== "exposure" && currentStep > 0 && currentStep <= allQuestions.length && !showChoicePanel && (
              <div className="mg-panel-state active">
                
                {/* Progress bar */}
                <div className="mg-audit-progress-container">
                  <div className="mg-progress-info">
                    <span>{currentStep <= coreQuestions.length ? "核心测评阶段" : "深度细节自检"}</span>
                    <span>第 {currentStep} / {allQuestions.length} 题</span>
                  </div>
                  <div className="mg-progress-bar-bg">
                    <div 
                      className="mg-progress-bar-fill" 
                      style={{ width: `${(currentStep / allQuestions.length) * 100}%` }}
                    ></div>
                  </div>
                </div>

                {/* Question */}
                <h3 className="mg-question-title">
                  {allQuestions[currentStep - 1].title}
                </h3>

                <div className="mg-options-list">
                  {allQuestions[currentStep - 1].options.map((opt, idx) => {
                    const questionId = allQuestions[currentStep - 1].id;
                    const isSelected = selectedOptions[questionId]?.score === opt.score && selectedOptions[questionId]?.text === opt.text;
                    return (
                      <button
                        key={idx}
                        onClick={() => handleSelectOption(allQuestions[currentStep - 1], opt.score, opt.text)}
                        className={`mg-option-btn ${isSelected ? "selected" : ""}`}
                      >
                        <span className="mg-option-dot"></span>
                        <span>{opt.text}</span>
                      </button>
                    );
                  })}
                </div>

                <div className="mg-quiz-footer-actions">
                  <button onClick={handlePrev} className="mg-prev-btn">
                    ← 返回上一题
                  </button>
                  
                  {selectedOptions[allQuestions[currentStep - 1].id] !== undefined && (
                    <button 
                      onClick={handleNext}
                      className="gradient-btn !rounded-full !py-2 !px-6 !border-none"
                    >
                      下一题 ➔
                    </button>
                  )}

                  <button onClick={handleStopQuiz} className="mg-stop-btn">
                    ⏹ 停止答题并生成报告
                  </button>
                </div>

              </div>
            )}

            {/* Choice Panel */}
            {activeTab !== "exposure" && showChoicePanel && (
              <div className="mg-panel-state mg-state-choice active">
                <span className="mg-welcome-icon">🏆</span>
                <h2 className="mg-choice-title">10 道核心主要问题已答完！</h2>
                <p className="mg-choice-desc">
                  您已经完成了最核心的基础防坑测试。现在您可以直接提交并查看当前的雷区风险报告；如果您希望对包含图片、GA4 埋点等 5 道次要细节进行深度核算，请继续回答。
                </p>
                <div className="mg-choice-btn-group">
                  <button className="mg-choice-btn-primary" onClick={handleProceedToResultsDirectly}>
                    直接提交并查看结果 →
                  </button>
                  <button className="mg-choice-btn-secondary" onClick={handleStartSecondaryQuiz}>
                    继续回答深度提问 (+5 题)
                  </button>
                </div>
              </div>
            )}

            {/* Result Report Panel */}
            {activeTab !== "exposure" && currentStep === 999 && (
              <div className="mg-panel-state mg-state-result active">
                
                <div className="mg-gauge-box">
                  <svg className="mg-gauge-svg">
                    <circle className="mg-gauge-track" cx="75" cy="75" r="65"></circle>
                    <circle 
                      className="mg-gauge-fill" 
                      cx="75" 
                      cy="75" 
                      r="65"
                      stroke={safetyInfo.color}
                      strokeDasharray="408.4"
                      strokeDashoffset={408.4 - (408.4 * Math.min(totalScore, 100)) / 100}
                    ></circle>
                  </svg>
                  <div className="mg-gauge-value">
                    <div className="mg-score-num" style={{ color: safetyInfo.color }}>{totalScore}</div>
                    <div className="mg-score-unit">雷区危险值</div>
                  </div>
                </div>

                <div className="mg-result-badge" style={{ backgroundColor: safetyInfo.color }}>
                  等级：{safetyInfo.level}
                </div>
                <p className="mg-result-summary">
                  {safetyInfo.summary}
                </p>

                <div className="mg-audit-report-details">
                  <h4 className="mg-details-title">🔍 测评踩中雷区与避坑建议清单：</h4>
                  <div className="mg-report-list">
                    {answersList.filter(([_, val]) => val.score > 0).map(([qId, val]) => {
                      const questionObj = allQuestions.find(q => q.id === parseInt(qId));
                      if (!questionObj) return null;
                      return (
                        <div className="mg-report-item" key={qId}>
                          <h5>❌ {questionObj.title}</h5>
                          <p>
                            <strong>您的回答：</strong>{val.text} <br />
                            <strong>避坑指引：</strong>{questionObj.explanation}
                          </p>
                        </div>
                      );
                    })}
                    {answersList.filter(([_, val]) => val.score > 0).length === 0 && (
                      <p style={{ fontSize: "13px", color: "#10b981", fontWeight: 600 }}>
                        ✓ 完美！您当前的合作方式或建站配置极其安全，没有踩中任何技术与合同雷区！
                      </p>
                    )}
                  </div>
                </div>

                <div className="mg-result-cta">
                  <p>如果自测有雷区扣分，建议与该公司签署附加约束性合同以保障资金与数据权益。</p>
                  <button onClick={handleCopyWechat} className="mg-result-cta-btn">
                    联系微信二次人工复核
                  </button>
                  <button className="mg-result-reset" onClick={handleReset}>
                    重新测评
                  </button>
                </div>

              </div>
            )}

            {/* Tab 3: Exposure Panel */}
            {activeTab === "exposure" && (
              <div className="mg-panel-state mg-state-exposure active">
                <h2 style={{ fontSize: "18px", fontWeight: 600, color: "#222226", display: "flex", alignItems: "center", gap: "8px", justifyContent: "center", marginBottom: "10px" }}>
                  曝光避雷低质建站公司 / 骗子商铺
                </h2>
                <p style={{ fontSize: "13px", color: "#555666", lineHeight: 1.6, maxWidth: "580px", margin: "0 auto 24px" }}>
                  遭遇建站商拖延不交付、SaaS 锁死不给导源码、或者虚假优化排名欺骗？在此登记对方公司名字或店铺名称。如果同一商家被多位外贸客户曝光，猫哥团队会主动帮大家<b>建立微信群组联系律师进行合规维权起诉</b>。
                </p>

                {exposureNotice && (
                  <div className={`mg-notice-bubble ${exposureNotice.type}`} style={{ marginBottom: "16px" }}>
                    {exposureNotice.msg}
                  </div>
                )}

                <form className="mg-exposure-form" onSubmit={handleExposureSubmit} style={{ maxWidth: "500px", margin: "0 auto", textAlign: "left" }}>
                  <div className="mg-form-row">
                    <label className="mg-form-label" htmlFor="expCompany">被诉公司或店铺全称：</label>
                    <input 
                      type="text" 
                      id="expCompany" 
                      className="mg-form-input" 
                      placeholder="例如：广州XX网络科技有限公司" 
                      value={expCompany}
                      onChange={(e) => setExpCompany(e.target.value)}
                      required 
                    />
                  </div>

                  <div className="mg-form-row">
                    <label className="mg-form-label" htmlFor="expPlatform">下单渠道平台：</label>
                    <select 
                      id="expPlatform" 
                      className="mg-form-select" 
                      value={expPlatform}
                      onChange={(e) => setExpPlatform(e.target.value)}
                      required
                    >
                      <option value="">-- 请选择下单平台 --</option>
                      <option value="淘宝">淘宝网</option>
                      <option value="闲鱼">闲鱼二手</option>
                      <option value="官网">服务商独立官网</option>
                      <option value="微信">微信个人/转账</option>
                      <option value="其他">其他渠道</option>
                    </select>
                  </div>

                  <div className="mg-form-row">
                    <label className="mg-form-label" htmlFor="expEmail">您的联系邮箱：</label>
                    <input 
                      type="email" 
                      id="expEmail" 
                      className="mg-form-input" 
                      placeholder="用于有新投诉时通知您拉群维权" 
                      value={expEmail}
                      onChange={(e) => setExpEmail(e.target.value)}
                      required 
                    />
                  </div>

                  <div className="mg-form-row">
                    <label className="mg-form-label" htmlFor="expExperience">您的真实踩坑经历简述 (50字以内)：</label>
                    <textarea 
                      id="expExperience" 
                      className="mg-form-input" 
                      rows={2} 
                      maxLength={50} 
                      placeholder="请简要陈述您的受骗或建站缺陷经历，最多50字" 
                      value={expExperience}
                      onChange={(e) => setExpExperience(e.target.value)}
                      required
                    ></textarea>
                  </div>

                  <div className="mg-form-row">
                    <label className="mg-form-label" htmlFor="expMathAns">安全防刷计算验证码：</label>
                    <div style={{ display: "flex", gap: "10px", alignItems: "center" }}>
                      <span style={{ fontWeight: "bold", color: "var(--blue, #0A4ECB)", fontSize: "15px" }}>
                        {mathChallenge.n1} + {mathChallenge.n2} =
                      </span>
                      <input 
                        type="number" 
                        id="expMathAns" 
                        className="mg-form-input" 
                        style={{ width: "100px", textAlign: "center" }} 
                        placeholder="答案" 
                        value={expMathAns}
                        onChange={(e) => setExpMathAns(e.target.value)}
                        required 
                      />
                    </div>
                  </div>

                  <div className="mg-form-warning-note">
                    💡 本平台仅作为外贸行业公益维权报备渠道。由于涉及商户信用，请务必保证提交的曝光情况完全属实。
                  </div>

                  <label className="mg-form-checkbox-row">
                    <input type="checkbox" required />
                    <span>我承诺上述所提交的曝光商户内容及平台完全属实真实可靠。</span>
                  </label>

                  <button type="submit" className="mg-form-submit-btn">
                    确认并提交曝光维权信息
                  </button>
                </form>
              </div>
            )}

          </div>

        </main>

        {/* 4. Right Sidebar */}
        <aside className="mg-archive-sidebar">
          
          <div className="mg-sidebar-widget mg-author-card">
            <div className="mg-author-avatar">🐱</div>
            <div className="mg-author-name">猫哥</div>
            <div className="mg-author-title">独立站 GEO 核心开发</div>
            <p className="mg-author-bio">
              15年谷歌SEO及出海建站经验，专注于营销流程构建与 AI GEO 规则布局，为您踢开流水线套版建站陷阱。
            </p>
          </div>

          <div className="mg-sidebar-widget">
            <h4 className="mg-widget-title">热门文章</h4>
            <div className="mg-sidebar-posts">
              {hotPosts.map((post, idx) => (
                <Link key={idx} href="/blog" className="mg-sidebar-post-item">
                  <h5 className="mg-sidebar-post-title">{post.title}</h5>
                  <span className="mg-sidebar-post-reads">阅读数 {post.views}</span>
                </Link>
              ))}
            </div>
          </div>

          <div className="mg-sidebar-widget">
            <h4 className="mg-widget-title">栏目分类</h4>
            <div className="mg-sidebar-tags">
              <Link href="/whychooseytcaptain" className="mg-sidebar-tag-link">外贸建站</Link>
              <Link href="/web-design-seo" className="mg-sidebar-tag-link">GEO优化</Link>
              <Link href="/blog" className="mg-sidebar-tag-link">出海博客</Link>
              <Link href="/host-recommendation" className="mg-sidebar-tag-link">服务器</Link>
            </div>
          </div>

        </aside>

      </div>
    </main>
  );
}
